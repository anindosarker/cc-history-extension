{
  "name": "cc-history",
  "displayName": "CC History",
  "description": "Claude Code session history: browse, search, diff and export every session. No time cutoff.",
  "version": "0.4.6",
  "publisher": "anindosarker",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anindosarker/cc-history-extension"
  },
  "bugs": {
    "url": "https://github.com/anindosarker/cc-history-extension/issues"
  },
  "homepage": "https://github.com/anindosarker/cc-history-extension#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "claude",
    "claude code",
    "history",
    "sessions",
    "transcript",
    "anthropic",
    "transcript viewer",
    "session history",
    "usage"
  ],
  "galleryBanner": {
    "color": "#1f1f1f",
    "theme": "dark"
  },
  "icon": "media/icon.png",
  "qna": "marketplace",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ccHistory",
          "title": "Claude Code History",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ccHistory": [
        {
          "id": "ccHistory.sessions",
          "name": "Sessions",
          "icon": "media/icon.svg",
          "contextualTitle": "Claude Code History"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ccHistory.sessions",
        "contents": "No Claude Code sessions found.\nLooking in the folder configured by `ccHistory.projectsDir` (default `~/.claude/projects`).\n[Refresh](command:ccHistory.refresh)\n[Open Settings](command:workbench.action.openSettings?%22ccHistory%22)",
        "when": "ccHistory.empty"
      }
    ],
    "commands": [
      {
        "command": "ccHistory.refresh",
        "title": "Refresh",
        "category": "Claude Code History",
        "icon": "$(refresh)"
      },
      {
        "command": "ccHistory.findSession",
        "title": "Find Session",
        "category": "Claude Code History",
        "icon": "$(search)"
      },
      {
        "command": "ccHistory.sortBy",
        "title": "Sort by...",
        "category": "Claude Code History",
        "icon": "$(list-ordered)"
      },
      {
        "command": "ccHistory.openSession",
        "title": "Open",
        "category": "Claude Code History"
      },
      {
        "command": "ccHistory.resume",
        "title": "Resume in Terminal",
        "category": "Claude Code History",
        "icon": "$(debug-restart)"
      },
      {
        "command": "ccHistory.exportText",
        "title": "Export as Text",
        "category": "Claude Code History",
        "icon": "$(export)"
      },
      {
        "command": "ccHistory.copySessionId",
        "title": "Copy Session ID",
        "category": "Claude Code History"
      },
      {
        "command": "ccHistory.revealJsonl",
        "title": "Reveal JSONL in Finder",
        "category": "Claude Code History"
      },
      {
        "command": "ccHistory.revealProject",
        "title": "Open in Finder",
        "category": "Claude Code History"
      },
      {
        "command": "ccHistory.copyProjectPath",
        "title": "Copy Path",
        "category": "Claude Code History"
      },
      {
        "command": "ccHistory.pinProject",
        "title": "Pin to top",
        "category": "Claude Code History",
        "icon": "$(pin)"
      },
      {
        "command": "ccHistory.unpinProject",
        "title": "Unpin",
        "category": "Claude Code History",
        "icon": {
          "light": "media/unpin-light.svg",
          "dark": "media/unpin-dark.svg"
        }
      },
      {
        "command": "ccHistory.refreshUsage",
        "title": "Refresh Usage",
        "category": "Claude Code History",
        "icon": "$(refresh)"
      },
      {
        "command": "ccHistory.openUsage",
        "title": "Show Usage",
        "category": "Claude Code History",
        "icon": "$(sparkle)"
      },
      {
        "command": "ccHistory.showUsageLog",
        "title": "Show Usage Log",
        "category": "Claude Code History"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ccHistory.findSession",
          "when": "view == ccHistory.sessions",
          "group": "navigation@1"
        },
        {
          "command": "ccHistory.sortBy",
          "when": "view == ccHistory.sessions",
          "group": "navigation@2"
        },
        {
          "command": "ccHistory.refresh",
          "when": "view == ccHistory.sessions",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "ccHistory.pinProject",
          "when": "view == ccHistory.sessions && viewItem == project-unpinned",
          "group": "inline@1"
        },
        {
          "command": "ccHistory.unpinProject",
          "when": "view == ccHistory.sessions && viewItem == project-pinned",
          "group": "inline@1"
        },
        {
          "command": "ccHistory.pinProject",
          "when": "view == ccHistory.sessions && viewItem == project-unpinned",
          "group": "0_pin@1"
        },
        {
          "command": "ccHistory.unpinProject",
          "when": "view == ccHistory.sessions && viewItem == project-pinned",
          "group": "0_pin@1"
        },
        {
          "command": "ccHistory.revealProject",
          "when": "view == ccHistory.sessions && viewItem =~ /^project-/",
          "group": "1_project@1"
        },
        {
          "command": "ccHistory.copyProjectPath",
          "when": "view == ccHistory.sessions && viewItem =~ /^project-/",
          "group": "1_project@2"
        },
        {
          "command": "ccHistory.openSession",
          "when": "view == ccHistory.sessions && viewItem == session",
          "group": "1_open@1"
        },
        {
          "command": "ccHistory.resume",
          "when": "view == ccHistory.sessions && viewItem == session",
          "group": "1_open@2"
        },
        {
          "command": "ccHistory.exportText",
          "when": "view == ccHistory.sessions && viewItem == session",
          "group": "2_export@1"
        },
        {
          "command": "ccHistory.copySessionId",
          "when": "view == ccHistory.sessions && viewItem == session",
          "group": "3_misc@1"
        },
        {
          "command": "ccHistory.revealJsonl",
          "when": "view == ccHistory.sessions && viewItem == session",
          "group": "3_misc@2"
        }
      ],
      "commandPalette": [
        {
          "command": "ccHistory.openSession",
          "when": "false"
        },
        {
          "command": "ccHistory.pinProject",
          "when": "false"
        },
        {
          "command": "ccHistory.unpinProject",
          "when": "false"
        },
        {
          "command": "ccHistory.copySessionId",
          "when": "false"
        },
        {
          "command": "ccHistory.revealJsonl",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Claude Code History",
      "properties": {
        "ccHistory.projectsDir": {
          "type": "string",
          "default": "~/.claude/projects",
          "description": "Folder that holds Claude Code project session logs. A leading ~ expands to your home directory."
        },
        "ccHistory.sessionsDir": {
          "type": "string",
          "default": "",
          "description": "Folder with Claude Code live session files (<pid>.json), used for the running / open / ended status dots. Leave empty to use the sessions folder next to ccHistory.projectsDir."
        },
        "ccHistory.tree.showStatus": {
          "type": "boolean",
          "default": true,
          "description": "Show live status dots (running, open, recently ended) in the Sessions view. When off, the sessions folder is not watched or polled."
        },
        "ccHistory.tree.sortBy": {
          "type": "string",
          "enum": [
            "activity",
            "name",
            "sessions"
          ],
          "enumDescriptions": [
            "Most recently active projects and sessions first.",
            "Projects and sessions A to Z.",
            "Projects with the most sessions first; sessions inside a project by last activity."
          ],
          "default": "activity",
          "description": "Order of projects and sessions in the Sessions view and in Find Session. Projects of the current workspace always come first. The Sort by... button in the view title changes this setting."
        },
        "ccHistory.tree.hideProjects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "/private/var/folders/**",
            "/tmp/**"
          ],
          "description": "Glob patterns for project folders to hide from the Sessions view, Find Session and the usage panel's week summary. A project is hidden when its working directory matches any pattern."
        },
        "ccHistory.claudeCommand": {
          "type": "string",
          "default": "claude",
          "description": "Command used to launch Claude Code when resuming a session."
        },
        "ccHistory.export.includeToolResults": {
          "type": "boolean",
          "default": false,
          "description": "Include tool results in plain-text exports."
        },
        "ccHistory.export.includeThinking": {
          "type": "boolean",
          "default": false,
          "description": "Include thinking blocks in plain-text exports."
        },
        "ccHistory.usage.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Poll Claude Code's rate-limit usage using the credentials Claude Code stores locally. The token is only ever sent to the Anthropic usage endpoint."
        },
        "ccHistory.usage.intervalSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 120,
          "description": "Seconds between usage polls while the window is focused (at least 120). Polling pauses when VS Code is not focused, and every window on the machine shares one fetch per interval."
        },
        "ccHistory.usage.showInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the usage widget in the status bar."
        },
        "ccHistory.usage.warnAt": {
          "type": "number",
          "default": 75,
          "minimum": 1,
          "maximum": 100,
          "description": "Utilisation percent at which the status bar widget turns to the warning colour."
        },
        "ccHistory.usage.errorAt": {
          "type": "number",
          "default": 90,
          "minimum": 1,
          "maximum": 100,
          "description": "Utilisation percent at which the status bar widget turns to the error colour."
        },
        "ccHistory.usage.colorMode": {
          "type": "string",
          "enum": [
            "background",
            "text",
            "off"
          ],
          "enumDescriptions": [
            "Tint the whole status bar item (statusBarItem.warningBackground / errorBackground).",
            "Colour only the text (charts.yellow / charts.red), no background.",
            "Never colour the widget."
          ],
          "default": "background",
          "description": "How the status bar widget shows that a usage threshold was crossed."
        },
        "ccHistory.usage.colorBy": {
          "type": "string",
          "enum": [
            "max",
            "fiveHour"
          ],
          "enumDescriptions": [
            "The highest utilisation among every shown limit (5-hour, weekly and per-model shares; extra usage is ignored).",
            "Only the 5-hour window."
          ],
          "default": "max",
          "description": "Which limit decides the status bar widget's colour."
        },
        "ccHistory.usage.format": {
          "type": "string",
          "enum": [
            "full",
            "compact",
            "max"
          ],
          "enumDescriptions": [
            "Every limit with a label, like \"5h 67% \u00b7 wk 47% \u00b7 F 92%\".",
            "Every limit as bare numbers, like \"67 \u00b7 47 \u00b7 92\".",
            "Only the highest limit, like \"F 92%\"."
          ],
          "default": "full",
          "description": "How much the status bar widget shows."
        },
        "ccHistory.usage.pulse": {
          "type": "boolean",
          "default": true,
          "description": "At the error level, swap the sparkle icon for a pulse and mark the limit that crossed the threshold with a warning icon."
        },
        "ccHistory.openAt": {
          "type": "string",
          "enum": [
            "oldest",
            "newest"
          ],
          "enumDescriptions": [
            "Start at the first message.",
            "Start scrolled to the latest message."
          ],
          "default": "oldest",
          "description": "Where the session viewer is scrolled when a session opens. The Old | New toggle in the viewer header changes this setting."
        }
      }
    }
  },
  "scripts": {
    "build": "pnpm run build:host && pnpm run build:webview",
    "build:host": "node esbuild.mjs",
    "build:webview": "vite build",
    "watch": "node esbuild.mjs --watch",
    "watch:webview": "vite build --watch",
    "typecheck": "tsc -p tsconfig.extension.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "lint": "eslint src scripts tests",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke-index.ts",
    "package": "pnpm run build && vsce package --no-dependencies",
    "vscode:prepublish": "pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.19",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/vscode": "1.95.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vscode/vsce": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "lucide-react": "^1.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@vscode/vsce-sign"
    ]
  },
  "dependencies": {
    "picomatch": "4.0.7"
  }
}
